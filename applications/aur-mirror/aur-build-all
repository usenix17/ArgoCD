# package via `build_timeout:` in the allowlist (e.g. a slow from-source .NET
# build) -- the largest value among the allowlist entries sharing a pkgbase wins.
BUILD_TIMEOUT     = int(os.environ.get("BUILD_TIMEOUT", "7200"))
