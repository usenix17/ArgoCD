#!/usr/bin/env python3
"""
AUR build pipeline: reads allowlist, scans recipes with Claude, builds approved
packages, scans artifacts with Trivy, signs with GPG, and publishes to the
pacman repo on the shared PV.

Runs in three phases (BUILD_PHASE env) so the GPG signing key and the Anthropic
API key are never present in any container that executes untrusted PKGBUILD
code:

  scan   -- for each approved package: fetch the AUR recipe at HEAD, run the
            Claude PKGBUILD security scan, and write a pass/fail verdict +
            resolved commit + recipe hash to the scan-state file on the state
            PV. NEVER runs makepkg, so the ANTHROPIC_API_KEY (mounted only
            here) never sits next to untrusted build code. ALWAYS exits 0 --
            per-package failures become fail-closed 'fail' verdicts so a bad
            recipe or an API blip can never block the build phase.
  build  -- check out each package's SCANNED commit, re-verify its recipe hash
            against what the scan phase saw, makepkg, Trivy. Vetted artifacts
            are staged with their SHA256. NO GPG key, NO API key here. Always
            exits 0 (per-package failures are held) so the sign phase still
            publishes what passed.
  sign   -- read the manifest, RE-VERIFY each staged artifact's SHA256, then
            GPG-sign and publish it, prune the repo, push metrics. Holds keep
            their last-good published build; the job stays green (a held
            package is an alert, not a job failure).
  all    -- run scan, build, then sign in one process (local/manual use only;
            no key isolation).

Model: packages track AUR HEAD and auto-update as long as they pass the Claude
scan + Trivy + build. There is no commit-pin lockfile and no human review
queue -- the scan is the gate, run against HEAD every run. State lives on a
Longhorn PV (SCAN_STATE), never git. A held package (scan/Trivy/build failure)
keeps serving its last-good build and raises an alert; it never fails the job.

Exit codes:
  0 -- pipeline ran (regardless of how many packages were held)
  1 -- infrastructure failure (allowlist unreadable, state PV unwritable, no
       staging manifest) -- i.e. the pipeline itself could not run
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import logging
import urllib.request
import urllib.parse
from pathlib import Path

import yaml

