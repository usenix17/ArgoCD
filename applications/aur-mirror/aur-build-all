#!/usr/bin/env python3
# pylint: disable=invalid-name  # installed as /usr/local/bin/aur-build-all
"""Entrypoint for one AUR mirror pipeline phase (BUILD_PHASE=scan|build|sign|all).

The code lives in the ``aurmirror`` package, installed next to this script in
the image at /usr/local/lib/aur-mirror. ``all`` runs every phase in one
process for local use only: it removes the key isolation between phases.
"""
import sys
from pathlib import Path

for _path in (Path(__file__).resolve().parent, Path("/usr/local/lib/aur-mirror")):
    if (_path / "aurmirror").is_dir():
        sys.path.insert(0, str(_path))
        break

# pylint: disable=wrong-import-position  # needs the path set above
from aurmirror import config as cfg  # noqa: E402
from aurmirror.build import run_build_phase  # noqa: E402
from aurmirror.common import setup_logging  # noqa: E402
from aurmirror.scan import run_scan_phase  # noqa: E402
from aurmirror.sign import run_sign_phase  # noqa: E402

PHASES = {"scan": run_scan_phase, "build": run_build_phase, "sign": run_sign_phase}


def main() -> int:
    """Run the configured phase, or all three in order."""
    setup_logging()
    if cfg.BUILD_PHASE in PHASES:
        return PHASES[cfg.BUILD_PHASE]()
    for phase in (run_scan_phase, run_build_phase, run_sign_phase):
        code = phase()
        if code:
            return code
    return 0


if __name__ == "__main__":
    sys.exit(main())
